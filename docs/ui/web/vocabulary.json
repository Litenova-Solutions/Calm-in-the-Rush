  "forks": [
    {
      "component": "table",
      "status": "forked",
      "reason": "The generated table container needs keyboard access and an accessible name on the requirements page, which renders wide Markdown tables. The fork adds tabIndex, role, and a named region, and exposes containerLabel so a caller can name the specific table.",
      "scope": [
        "components/ui/table.tsx"
      ],
      "owner": "Product and engineering",
      "reviewWhen": [
        "the shadcn table component changes upstream",
        "upstream adds keyboard access to the table container",
        "the Markdown table treatment changes"
      ],
      "evidence": [
        "UI-REQUIREMENTS-AXE",
        "UI-REQUIREMENTS-READY"
      ]
    }
