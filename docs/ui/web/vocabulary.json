  "forks": [
    {
      "component": "table",
      "status": "forked",
      "reason": "The generated table container is a horizontally scrollable region with no keyboard access and no accessible name. axe reports scrollable-region-focusable as a serious violation on the requirements page, which renders wide Markdown tables. The fork adds tabIndex, role, and a named region, and exposes containerLabel so a caller can name the specific table.",
      "scope": [
        "components/ui/table.tsx"
      ],
      "owner": "Product and engineering",
      "reviewWhen": [
        "the shadcn table component changes upstream",
        "upstream adds keyboard access to the table container",
        "the Markdown table treatment changes"
      ],
      "evidence": [
        "UI-REQUIREMENTS-AXE",
        "UI-REQUIREMENTS-READY"
      ]
    }
  ],
  "specialists": [],
  "runtimeStyles": [
    {
      "scope": [
        "app/opengraph-image.tsx"
      ],
      "properties": [],
      "reason": "The social image is rendered by Next.js ImageResponse through satori, which does not support class names or a stylesheet. Inline style is the only available API on this surface, and it produces a PNG rather than DOM.",
      "evidence": [
        "UI-LANDING-READY"
      ]
    }
  ],
