{
  "name": "calm-in-the-rush",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.13.1"
  },
  "scripts": {
    "dev:web": "pnpm --filter @calm/web dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "pnpm --recursive --if-present lint",
    "type-check": "pnpm --recursive --if-present type-check",
    "docs:check": "node scripts/validate-docs.mjs",
    "standards:check": "node standards/tools/validate-consumer.mjs",
    "ui:check": "node standards/tools/validate-ui.mjs",
    "version:check": "node scripts/validate-version.mjs",
    "format:check": "pnpm exec prettier --check .",
    "format": "pnpm exec prettier --write .",
    "verify": "pnpm format:check && pnpm version:check && pnpm lint && pnpm ui:check && pnpm type-check && pnpm docs:check && pnpm standards:check && pnpm build && git diff --check"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3"
  }
}
