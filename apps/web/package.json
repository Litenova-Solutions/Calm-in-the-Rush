    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "react-native-web": "0.21.2",
    "remark-gfm": "4.0.1",
    "tamagui": "2.7.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
