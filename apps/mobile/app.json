{
  "expo": {
    "name": "Calm in the Rush",
    "slug": "calm-in-the-rush",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "calmintherush",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "solutions.litenova.calmintherush"
    },
    "android": {
      "package": "solutions.litenova.calmintherush",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10252B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        { "backgroundColor": "#10252B", "image": "./assets/splash.png", "imageWidth": 200 }
      ],
      "expo-font",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
